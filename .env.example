# Environment configuration for LLM persona extraction pipeline
# Copy this file to .env and fill in your API credentials

# Option 1: OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5
WANDB_API_KEY=your_wandb_api_key_here

# # Option 2: Azure OpenAI Configuration (alternative to OpenAI)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your_azure_openai_key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.5
# AZURE_OPENAI_API_VERSION=your_azure_openai_api_version_of_gpt-5.5

# Optional: local OpenAI-compatible LLM endpoint (e.g. Qwen via vLLM)
# PM3_LLM_BASE_URL=http://127.0.0.1:8002/v1
# PM3_LLM_API_KEY=local

# Optional: mem0 embedding model/deployment and output dimensions.
# Defaults: local endpoint -> sentence-transformers/all-MiniLM-L6-v2, 384;
# Azure -> AZURE_OPENAI_DEPLOYMENT_NAME_EMBED (or text-embedding-3-large), 3072.
# Set both values when selecting a different model. Local models run on CPU.
# PM3_EMBED_MODEL=sentence-transformers/all-mpnet-base-v2
# PM3_EMBED_DIMS=768
# Changing embeddings requires rebuilding the memory store in a new run_dir.

# Notes:
# - You need either OpenAI OR Azure OpenAI configuration, not both
# - The pipeline will try Azure OpenAI first, then fall back to OpenAI
